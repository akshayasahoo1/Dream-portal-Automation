{
  "name": "dream-portal-automation",
  "version": "1.0.0",
  "description": "Playwright (TypeScript) UI + AI-assisted test automation for the Dream Portal journaling site",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "playwright test --project=chromium --project=unit",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:ui-only": "playwright test tests/ui --project=chromium",
    "test:ai": "playwright test tests/ai --project=chromium",
    "test:unit": "playwright test --project=unit",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit --project=unit",
    "test:mock": "cross-env USE_MOCK=1 playwright test --project=chromium --project=unit",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure": "npm run allure:generate && npm run allure:open",
    "inspect": "node scripts/inspect-site.mjs",
    "mock:server": "node mock-site/server.js",
    "fake-ai": "node scripts/fake-openai-server.js",
    "install:browsers": "playwright install --with-deps chromium",
    "clean": "rimraf test-results playwright-report allure-results allure-report logs debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
