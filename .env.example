# ---------- Target ----------
# Site under test (trailing slash optional)
BASE_URL=https://arjitnigam.github.io/myDreams/

# ---------- Browser ----------
HEADLESS=true
# Optional: use a locally-installed Chromium/Chrome instead of Playwright's download
# CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---------- AI validation (Part 2 - bonus) ----------
# auto      -> OpenAI if OPENAI_API_KEY is set, otherwise offline heuristic fallback
# openai    -> OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
# ollama    -> local open-source model served by Ollama
# heuristic -> offline keyword classifier (no network; NOT a real AI model)
AI_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Fraction of dreams whose AI label must match the table label (0..1)
AI_MIN_ACCURACY=0.8
# true = EVERY dream must match (zero tolerance)
AI_STRICT=false
